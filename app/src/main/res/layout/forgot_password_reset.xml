<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/drawable_shape">

    <!-- Main Frame -->
    <FrameLayout
        android:layout_width="768.62dp"
        android:layout_height="1167.93dp"
        android:layout_marginLeft="-164dp"
        android:layout_marginTop="-146dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="160dp"
            android:src="@drawable/rectangle_22" />

        <ImageView
            android:layout_width="639dp"
            android:layout_height="390dp"
            android:layout_marginLeft="50dp"
            android:layout_marginTop="80dp"
            android:src="@drawable/rectangle_11" />

        <ImageView
            android:layout_width="491dp"
            android:layout_height="367dp"
            android:layout_gravity="left"
            android:layout_marginLeft="130dp"
            android:layout_marginTop="850dp"
            android:layout_marginBottom="0dp"
            android:src="@drawable/rectangle_33" />

        <ImageView
            android:layout_width="402dp"
            android:layout_height="224dp"
            android:layout_marginLeft="140dp"
            android:layout_marginTop="200dp"
            android:src="@drawable/logo" />

    </FrameLayout>

    <!-- Login Form -->
    <FrameLayout
        android:layout_width="341dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="340dp"
        android:background="@drawable/drawable_shape_1">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="59.29dp"
            android:layout_gravity="top"
            android:layout_marginLeft="0dp"
            android:fontFamily="@font/nunito_bold"
            android:gravity="left|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:text="RESET PASSWORD"
            android:textColor="#FFFFB041"
            android:textSize="30dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_gravity="top"
            android:layout_marginLeft="0dp"
            android:layout_marginTop="65dp"
            android:fontFamily="@font/nunito_regular"
            android:gravity="left|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Enter your new password"
            android:textColor="#FFFFB041"
            android:textSize="14dp" />

        <EditText
            android:id="@+id/password1_input"
            android:layout_width="300dp"
            android:layout_height="35dp"
            android:layout_marginTop="90dp"
            android:background="@drawable/drawable_shape_2"
            android:inputType="textPassword"
            android:paddingLeft="10dp"
            android:scaleType="centerInside" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginTop="140dp"
            android:fontFamily="@font/nunito_regular"
            android:gravity="left|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Confirm your password"
            android:textColor="#FFFFB041"
            android:textSize="14dp" />

        <EditText
            android:id="@+id/password2_input"
            android:layout_width="301dp"
            android:layout_height="42dp"
            android:layout_marginTop="165dp"
            android:background="@drawable/drawable_shape_2"
            android:inputType="textPassword"
            android:paddingStart="10dp"
            android:scaleType="centerCrop" />

    </FrameLayout>

    <!-- Register Button at Bottom-Right -->
    <FrameLayout
        android:layout_width="317dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="60dp"
        android:layout_marginTop="620dp">

        <Button
            android:id="@+id/submit_button"
            android:layout_width="231dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:backgroundTint="#FFD580"
            android:fontFamily="@font/nunito_bold"
            android:text="submit"
            android:textColor="#333333"
            android:textSize="24dp" />

    </FrameLayout>

</FrameLayout>