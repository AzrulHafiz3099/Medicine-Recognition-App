<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container_med_details_reminder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"> <!-- Subtle gradient background -->

    <!-- Top Bar -->
    <FrameLayout
        android:id="@+id/container_search_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:layout_gravity="top"
        android:background="@drawable/container_link"
        android:elevation="6dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/img_back"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="12dp"
            android:layout_gravity="center_vertical|start"
            android:src="@drawable/arrow_back"
            android:tint="@android:color/black"
            android:contentDescription="Back Button" />

        <TextView
            android:id="@+id/text_add_your_med"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Your Medicine"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="28dp"
            android:textColor="@android:color/black"
            android:fontFamily="@font/nunito_bold"
            android:textSize="18sp" />
    </FrameLayout>

    <!-- Upper Section -->
    <FrameLayout
        android:id="@+id/container_group"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="70dp"
        android:padding="16dp">

        <ImageView
            android:id="@+id/image_rectangle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/image_rectangle"
            android:scaleType="centerCrop"
            android:alpha="0.8" />

        <ImageView
            android:id="@+id/img_drugImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:src="@drawable/logo"
            android:contentDescription="Drug Logo" />

        <TextView
            android:id="@+id/text_medication_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="220dp"
            android:gravity="center"
            android:text="Medication Details:"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:fontFamily="@font/nunito_bold"
            android:shadowColor="@android:color/black"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4" />
    </FrameLayout>

    <!-- Details Section -->
    <FrameLayout
        android:id="@+id/container_group1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="380dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/container_link"
        android:elevation="8dp"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtGenericName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center"
            android:text="Paracetamol"
            android:textColor="@android:color/black"
            android:textSize="22sp"
            android:fontFamily="@font/nunito_bold" />

        <TextView
            android:id="@+id/textView_dosage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:text="Dosage:"
            android:textStyle="bold"
            android:textColor="#FF544C4C"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txt_Dosage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp"
            android:text="660 mg"
            android:textColor="#FF000000"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textView_dosageForm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="100dp"
            android:text="Dosage Form:"
            android:textStyle="bold"
            android:textColor="#FF544C4C"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txt_DosageForm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="120dp"
            android:text="Tablet"
            android:textColor="#FF000000"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textView_dosageUsage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="140dp"
            android:text="Recommended Usage:"
            android:textStyle="bold"
            android:textColor="#FF544C4C"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txt_DosageUsage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="160dp"
            android:text="1 dose up to 4 times"
            android:textColor="#FF000000"
            android:textSize="14sp" />
    </FrameLayout>

    <!-- Button Section -->
    <LinearLayout
        android:id="@+id/container_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="600dp"
        android:gravity="center"
        android:padding="16dp">

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/image_orange"
            android:text="ADD REMINDER"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:fontFamily="@font/nunito_bold" />
    </LinearLayout>
</FrameLayout>
