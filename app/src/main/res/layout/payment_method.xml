<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container_view_payment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"> <!-- Gradient background -->

    <!-- Back Button -->
    <ImageView
        android:id="@+id/img_back"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="16dp"
        android:layout_gravity="top|start"
        android:src="@drawable/arrow_back"
        android:tint="@android:color/black"
        android:contentDescription="Back Button" />

    <!-- Title -->
    <TextView
        android:id="@+id/text_payment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginRight="80dp"
        android:layout_gravity="top|center_horizontal"
        android:text="Payment"
        android:textColor="@android:color/black"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Payment Options -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <!-- Cash on Delivery -->
        <androidx.cardview.widget.CardView
            android:id="@+id/payment_COD"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:backgroundTint="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/image_main2"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/buyer_pay_icon"
                    android:contentDescription="Cash Icon" />

                <TextView
                    android:id="@+id/container_group1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="Cash on Delivery"
                    android:textColor="@android:color/black"
                    android:textSize="18sp" />

                <ImageView
                    android:id="@+id/image_keyboard_up1"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/baseline_arrow_forward_ios_24"
                    android:tint="@android:color/darker_gray"
                    android:contentDescription="Arrow Icon" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- FPX -->
        <androidx.cardview.widget.CardView
            android:id="@+id/payment_FPX"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:backgroundTint="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/image_main"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/fpx_seeklogo"
                    android:contentDescription="FPX Icon" />

                <TextView
                    android:id="@+id/container_group2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="FPX"
                    android:textColor="@android:color/black"
                    android:textSize="18sp" />

                <ImageView
                    android:id="@+id/image_keyboard_up2"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/baseline_arrow_forward_ios_24"
                    android:tint="@android:color/darker_gray"
                    android:contentDescription="Arrow Icon" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

