<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="290dp"
    android:layout_height="650dp">

    <FrameLayout
        android:id="@+id/container_sidebar"
        android:layout_width="match_parent"
        android:layout_height="45.45dp"
        android:background="#80000000">

        <FrameLayout
            android:id="@+id/container_iphone"
            android:layout_width="match_parent"
            android:layout_height="664dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            android:layout_marginBottom="0dp"
            android:background="@drawable/container_iphone">

            <FrameLayout
                android:id="@+id/container_home_screen_one"
                android:layout_width="match_parent"
                android:layout_height="657dp"
                android:layout_gravity="top|left"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/container_home_screen_one">

                <ImageView
                    android:id="@+id/image_group"
                    android:layout_width="22.04dp"
                    android:layout_height="11.08dp"
                    android:layout_marginLeft="26.63dp"
                    android:layout_marginTop="58.08dp"
                    android:layout_marginRight="329.2dp"
                    android:layout_marginBottom="744.16dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/baseline_menu_24" />

                <TextView
                    android:id="@+id/text_common_medicine"
                    android:layout_width="wrap_content"
                    android:layout_height="32.47dp"
                    android:layout_gravity="top|left"
                    android:layout_marginLeft="25.94dp"
                    android:layout_marginTop="299.95dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="common medicine"
                    android:textColor="#FF27214D"
                    android:textSize="24dp" />

                <FrameLayout
                    android:id="@+id/container_group2"
                    android:layout_width="152.65dp"
                    android:layout_height="183.54dp"
                    android:layout_gravity="bottom|left"
                    android:layout_marginLeft="24.96dp"
                    android:layout_marginBottom="272.7dp">

                    <ImageView
                        android:id="@+id/image_rectangle1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/image_rectangle1"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:id="@+id/image_vector"
                        android:layout_width="16.05dp"
                        android:layout_height="14.37dp"
                        android:layout_marginLeft="120.54dp"
                        android:layout_marginTop="16.42dp"
                        android:layout_marginRight="16.06dp"
                        android:layout_marginBottom="152.74dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/tick2" />

                    <TextView
                        android:id="@+id/text_paracetamol"
                        android:layout_width="wrap_content"
                        android:layout_height="21dp"
                        android:layout_gravity="left"
                        android:layout_marginLeft="11.98dp"
                        android:layout_marginTop="114.02dp"
                        android:layout_marginBottom="48.52dp"
                        android:gravity="left|center_vertical"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="Paracetamol "
                        android:textColor="#FF27214D"
                        android:textSize="16dp" />

                    <TextView
                        android:id="@+id/container_group3"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_gravity="left"
                        android:layout_marginLeft="12.98dp"
                        android:layout_marginTop="144.95dp"
                        android:layout_marginBottom="20.58dp"
                        android:gravity="left|center_vertical"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="RM 4.60"
                        android:textColor="#FFF08626"
                        android:textSize="14dp" />

                    <ImageView
                        android:id="@+id/image_group1"
                        android:layout_width="24.08dp"
                        android:layout_height="24.08dp"
                        android:layout_gravity="bottom|right"
                        android:layout_marginRight="16.5dp"
                        android:layout_marginBottom="18.06dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/baseline_add_circle_outline_24" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/container_group10"
                    android:layout_width="140.53dp"
                    android:layout_height="150.49dp"
                    android:layout_gravity="top|left"
                    android:layout_marginLeft="336.05dp"
                    android:layout_marginTop="647.19dp" />

                <FrameLayout
                    android:id="@+id/container_group15"
                    android:layout_width="46.15dp"
                    android:layout_height="42.16dp"
                    android:layout_gravity="top|left"
                    android:layout_marginLeft="312.58dp"
                    android:layout_marginTop="41.1dp" />

                <ImageView
                    android:id="@+id/image_paracetamol"
                    android:layout_width="78dp"
                    android:layout_height="79dp"
                    android:layout_gravity="top|left"
                    android:layout_marginLeft="64.94dp"
                    android:layout_marginTop="380.95dp"
                    android:scaleType="centerInside" />


                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="567dp"
                    android:layout_gravity="top|left"
                    android:layout_marginLeft="-10dp"
                    android:layout_marginTop="54dp"
                    android:background="@drawable/drawable_shape">

                    <LinearLayout
                        android:id="@+id/container_sidebar_open"
                        android:layout_width="match_parent"
                        android:layout_height="603dp"
                        android:layout_gravity="start"
                        android:layout_margin="0dp"
                        android:gravity="left|top"
                        android:orientation="vertical"
                        android:padding="0dp">


                        <LinearLayout
                            android:id="@+id/container_navigation"
                            android:layout_width="match_parent"
                            android:layout_height="572dp"
                            android:layout_gravity="start"
                            android:layout_margin="0dp"
                            android:gravity="left|top"
                            android:orientation="vertical"
                            android:padding="0dp">

                            <LinearLayout
                                android:id="@+id/container_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="-1dp"
                                android:layout_marginBottom="-1dp"
                                android:clipToPadding="false"
                                android:gravity="left|top"
                                android:orientation="horizontal"
                                android:paddingLeft="12dp"
                                android:paddingTop="1dp"
                                android:paddingRight="12dp"
                                android:paddingBottom="1dp">

                                <TextView
                                    android:id="@+id/text_overline"
                                    android:layout_width="140dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginTop="-1dp"
                                    android:layout_marginBottom="-1dp"
                                    android:background="@drawable/container_link"
                                    android:gravity="left|center_vertical"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:singleLine="true"
                                    android:text="Main"
                                    android:textColor="#FF5C5E64"
                                    android:textSize="20dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/container_profile"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:clipToPadding="false"
                                android:gravity="left|center_vertical"
                                android:orientation="horizontal"
                                android:paddingLeft="12dp"
                                android:paddingTop="10dp"
                                android:paddingRight="12dp"
                                android:paddingBottom="10dp">

                                <ImageView
                                    android:id="@+id/image_icon_user"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:scaleType="centerInside"

                                    android:src="@drawable/baseline_person_outline_24" />

                                <TextView
                                    android:id="@+id/text_profile"
                                    android:layout_width="match_parent"
                                    android:layout_height="20dp"
                                    android:layout_marginLeft="12dp"
                                    android:layout_weight="1"
                                    android:gravity="left|center_vertical"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:singleLine="true"
                                    android:text="Profile"
                                    android:textColor="#FF000000"
                                    android:textSize="20dp" />

                            </LinearLayout>

                            <FrameLayout
                                android:layout_width="172dp"
                                android:layout_height="0dp"
                                android:layout_marginTop="12dp">

                                <LinearLayout
                                    android:id="@+id/container_links_container"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="left|top"
                                    android:orientation="vertical">

                                </LinearLayout>

                                <ImageView
                                    android:id="@+id/image_line"
                                    android:layout_width="2dp"
                                    android:layout_height="68dp"
                                    android:layout_gravity="left"
                                    android:layout_marginLeft="-13dp"
                                    android:layout_marginBottom="0dp"
                                    android:background="@drawable/image_line"
                                    android:scaleType="centerInside" />
                            </FrameLayout>

                            <LinearLayout
                                android:id="@+id/container_patient"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/container_link3"
                                android:clickable="true"
                                android:clipToPadding="false"
                                android:focusable="true"
                                android:gravity="left|center_vertical"
                                android:orientation="horizontal"
                                android:paddingLeft="12dp"
                                android:paddingTop="10dp"
                                android:paddingRight="12dp"
                                android:paddingBottom="10dp">

                                <ImageView
                                    android:id="@+id/image_icon_patient"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:scaleType="centerInside"
                                    android:src="@drawable/manage_patient" />

                                <TextView
                                    android:id="@+id/text_patient"
                                    android:layout_width="match_parent"
                                    android:layout_height="22dp"
                                    android:layout_marginLeft="12dp"
                                    android:layout_weight="1"
                                    android:gravity="left|center_vertical"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:singleLine="true"
                                    android:text="Manage Patient"
                                    android:textColor="#FF5C5E64"
                                    android:textSize="20dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/container_drugReminder"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/container_link3"
                                android:clipToPadding="false"
                                android:gravity="left|center_vertical"
                                android:orientation="horizontal"
                                android:paddingLeft="12dp"
                                android:paddingTop="10dp"
                                android:paddingRight="12dp"
                                android:paddingBottom="10dp">

                                <ImageView
                                    android:id="@+id/image_icon_calendar"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:scaleType="centerInside"
                                    android:src="@drawable/baseline_calendar_month_24" />

                                <TextView
                                    android:id="@+id/text_drug_reminder"
                                    android:layout_width="match_parent"
                                    android:layout_height="22dp"
                                    android:layout_marginLeft="12dp"
                                    android:layout_weight="1"
                                    android:gravity="left|center_vertical"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:singleLine="true"
                                    android:text="Drug reminder"
                                    android:textColor="#FF5C5E64"
                                    android:textSize="20dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/container_symptomsDetector"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/container_link4"
                                android:clipToPadding="false"
                                android:gravity="left|center_vertical"
                                android:orientation="horizontal"
                                android:paddingLeft="12dp"
                                android:paddingTop="10dp"
                                android:paddingRight="12dp"
                                android:paddingBottom="10dp">

                                <ImageView
                                    android:id="@+id/image_virus_target"
                                    android:layout_width="26dp"
                                    android:layout_height="30dp"
                                    android:scaleType="centerInside"
                                    android:src="@drawable/baseline_coronavirus_24" />

                                <TextView
                                    android:id="@+id/text_symptoms_detector"
                                    android:layout_width="match_parent"
                                    android:layout_height="22dp"
                                    android:layout_marginLeft="12dp"
                                    android:layout_weight="1"
                                    android:gravity="left|center_vertical"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:singleLine="true"
                                    android:text="Symptoms detector"
                                    android:textColor="#FF5C5E64"
                                    android:textSize="20dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/container_drugSearch"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/container_link5"
                                android:clipToPadding="false"
                                android:gravity="left|center_vertical"
                                android:orientation="horizontal"
                                android:paddingLeft="12dp"
                                android:paddingTop="10dp"
                                android:paddingRight="12dp"
                                android:paddingBottom="10dp">

                                <ImageView
                                    android:id="@+id/container_drug"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:scaleType="centerInside"
                                    android:src="@drawable/search" />

                                <TextView
                                    android:id="@+id/text_drug_search"
                                    android:layout_width="match_parent"
                                    android:layout_height="20dp"
                                    android:layout_marginLeft="12dp"
                                    android:layout_weight="1"
                                    android:gravity="left|center_vertical"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:singleLine="true"
                                    android:text="Search Medicine"
                                    android:textColor="#FF5C5E64"
                                    android:textSize="20dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/container_medRecognition"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/container_link5"
                                android:clipToPadding="false"
                                android:gravity="left|center_vertical"
                                android:orientation="horizontal"
                                android:paddingLeft="12dp"
                                android:paddingTop="10dp"
                                android:paddingRight="12dp"
                                android:paddingBottom="10dp">

                                <ImageView
                                    android:id="@+id/container_pill"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:scaleType="centerInside"
                                    android:src="@drawable/baseline_document_scanner_24" />

                                <TextView
                                    android:id="@+id/text_drug_identifier"
                                    android:layout_width="match_parent"
                                    android:layout_height="20dp"
                                    android:layout_marginLeft="12dp"
                                    android:layout_weight="1"
                                    android:gravity="left|center_vertical"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:singleLine="true"
                                    android:text="Medicine Recognition"
                                    android:textColor="#FF5C5E64"
                                    android:textSize="20dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/container_vendor"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/container_link6"
                                android:clipToPadding="false"
                                android:gravity="left|center_vertical"
                                android:orientation="horizontal"
                                android:paddingLeft="12dp"
                                android:paddingTop="10dp"
                                android:paddingRight="12dp"
                                android:paddingBottom="10dp">

                                <ImageView
                                    android:id="@+id/image_bag"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:scaleType="centerInside"
                                    android:src="@drawable/baseline_local_pharmacy_24" />

                                <TextView
                                    android:id="@+id/text_pharmacy_link"
                                    android:layout_width="match_parent"
                                    android:layout_height="20dp"
                                    android:layout_marginLeft="12dp"
                                    android:layout_weight="1"
                                    android:gravity="left|center_vertical"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:singleLine="true"
                                    android:text="Pharmacy"
                                    android:textColor="#FF5C5E64"
                                    android:textSize="20dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/container_yourOrder"
                                android:layout_width="251dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/container_link7"
                                android:clipToPadding="false"
                                android:gravity="left|center_vertical"
                                android:orientation="horizontal"
                                android:paddingLeft="12dp"
                                android:paddingTop="10dp"
                                android:paddingRight="12dp"
                                android:paddingBottom="10dp">

                                <ImageView
                                    android:id="@+id/image_shopping_cart"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:scaleType="centerInside"
                                    android:src="@drawable/baseline_add_shopping_cart_25" />

                                <TextView
                                    android:id="@+id/text_your_orders"
                                    android:layout_width="match_parent"
                                    android:layout_height="20dp"
                                    android:layout_marginLeft="12dp"
                                    android:layout_weight="1"
                                    android:gravity="left|center_vertical"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:singleLine="true"
                                    android:text="Your Orders"
                                    android:textColor="#FF5C5E64"
                                    android:textSize="20dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/container_tnc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:clipToPadding="false"
                                android:gravity="left|center_vertical"
                                android:orientation="horizontal"
                                android:paddingLeft="12dp"
                                android:paddingTop="10dp"
                                android:paddingRight="12dp"
                                android:paddingBottom="10dp">

                                <ImageView
                                    android:id="@+id/image_icon_user1"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:scaleType="centerInside"
                                    android:src="@drawable/terms" />

                                <TextView
                                    android:id="@+id/terms"
                                    android:layout_width="match_parent"
                                    android:layout_height="20dp"
                                    android:layout_marginLeft="12dp"
                                    android:layout_weight="1"
                                    android:gravity="left|center_vertical"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:singleLine="true"
                                    android:text="Terms and Conditions"
                                    android:textColor="#FF000000"
                                    android:textSize="20dp" />


                            </LinearLayout>

                            <FrameLayout
                                android:layout_width="172dp"
                                android:layout_height="0dp"
                                android:layout_marginTop="12dp">

                                <LinearLayout
                                    android:id="@+id/container_links_container1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="left|top"
                                    android:orientation="vertical">

                                </LinearLayout>

                                <ImageView
                                    android:id="@+id/image_line1"
                                    android:layout_width="2dp"
                                    android:layout_height="32dp"
                                    android:layout_gravity="left"
                                    android:layout_marginLeft="-13dp"
                                    android:layout_marginBottom="0dp"
                                    android:background="@drawable/image_line1"
                                    android:scaleType="centerInside" />
                            </FrameLayout>


                            <Button
                                android:id="@+id/btn_logout"
                                android:layout_width="131.5dp"
                                android:layout_height="41dp"
                                android:layout_gravity="top|left"
                                android:backgroundTint="#FF0000"
                                android:layout_marginLeft="60dp"
                                android:scaleType="centerInside"
                                android:text="Logout" />
                        </LinearLayout>
                    </LinearLayout>

                </FrameLayout>

                <FrameLayout
                    android:id="@+id/container_group16"
                    android:layout_width="149dp"
                    android:layout_height="31dp"
                    android:layout_gravity="bottom|left"
                    android:layout_marginLeft="58dp"
                    android:layout_marginBottom="109.32dp"
                    android:background="@drawable/container_group16">

                </FrameLayout>

            </FrameLayout>
        </FrameLayout>
    </FrameLayout>
</androidx.drawerlayout.widget.DrawerLayout>