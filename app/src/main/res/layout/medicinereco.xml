<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container_medicine_recognition"
    android:layout_width="match_parent"
    android:layout_height="844dp"
    android:background="@drawable/gradient_background">

    <!-- Title -->

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/header_section"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:orientation="horizontal"
        android:background="@drawable/image_rectangle2"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/img_back"
            android:layout_width="27dp"
            android:layout_marginTop="10dp"
            android:layout_height="wrap_content"
            android:src="@drawable/arrow_back"
            android:contentDescription="Back Button" />

        <TextView
            android:id="@+id/text_recent_orders"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="8dp"
            android:text="Scan Your Drug"
            android:textSize="18sp"
            android:textColor="#000000"
            android:fontFamily="@font/nunito_bold" />
    </LinearLayout>

    <!-- Button Container -->
    <FrameLayout
        android:layout_width="284dp"
        android:layout_height="75dp"
        android:layout_marginLeft="53dp"
        android:layout_marginTop="570dp"
        android:layout_gravity="top|left"
        android:elevation="4dp">

        <!-- Button Background -->
        <Button
            android:id="@+id/btn_scan"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:backgroundTint="#FFD580"
            android:layout_marginTop="5dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:scaleType="centerInside"
            android:elevation="2dp" />

    </FrameLayout>

    <!-- Scan Drug Text and Icon -->
    <FrameLayout
        android:id="@+id/container_group1"
        android:layout_width="163dp"
        android:layout_height="33dp"
        android:layout_marginLeft="125dp"
        android:layout_marginBottom="215dp"
        android:layout_gravity="bottom|left"
        android:elevation="4dp">

        <TextView
            android:id="@+id/text_scan_drug"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:text="  Scan Drug"
            android:textColor="#000"
            android:textSize="18sp"
            android:fontFamily="sans-serif" />

        <ImageView
            android:id="@+id/image_vector1"
            android:layout_width="36.88dp"
            android:layout_height="33dp"
            android:layout_marginRight="126.12dp"
            android:scaleType="centerInside"
            android:src="@drawable/baseline_document_scanner_24" />
    </FrameLayout>

    <!-- Main Image -->
    <ImageView
        android:id="@+id/image_group1"
        android:layout_width="match_parent"
        android:layout_height="472.28dp"
        android:layout_marginLeft="20.18dp"
        android:layout_marginRight="22.89dp"
        android:layout_marginTop="100dp"
        android:layout_marginBottom="245.72dp"
        android:scaleType="centerCrop"
        android:src="@drawable/baseline_crop_free_24"
        android:elevation="4dp" />

    <!-- Decorative Vector Icon -->
    <ImageView
        android:id="@+id/image_vector2"
        android:layout_width="6.25dp"
        android:layout_height="12.5dp"
        android:layout_marginLeft="44.25dp"
        android:layout_marginRight="360.5dp"
        android:layout_marginTop="55.75dp"
        android:layout_marginBottom="775.75dp"
        android:scaleType="centerInside" />


</FrameLayout>
